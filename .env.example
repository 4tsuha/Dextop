# Copy to .env. Never commit the real file or keystore.
DEXTOP_KEYSTORE_FILE=android/keystore/dextop-upload.jks
DEXTOP_KEY_ALIAS=dextop-upload
DEXTOP_STORE_PASSWORD=replace-with-a-long-random-password
DEXTOP_KEY_PASSWORD=replace-with-a-long-random-password

# Optional Google Play Developer API service-account JSON path.
PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/to/play-service-account.json
PLAY_TRACK=internal
